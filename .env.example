# 首次初始化的应用数据库名。
MYSQL_DATABASE=replace_with_db_name
# 后端使用的普通 MySQL 用户。
MYSQL_USER=replace_with_db_user
# 后端普通 MySQL 用户的密码。
MYSQL_PASSWORD=replace_with_db_password
# MySQL 初始化专用的 root 密码。
MYSQL_ROOT_PASSWORD=replace_with_db_root_password
# Redis 和 API 共用的认证密码。
REDIS_PASSWORD=replace_with_redis_password
